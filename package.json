{
  "name": "potover",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/verify-article-previews.mjs --export",
    "start": "next start",
    "lint": "eslint app components lib worker/src packages --ext .ts,.tsx",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "collect:gtowizard": "node scripts/collect-gtowizard.mjs",
    "collect:public-sources": "node scripts/collect-public-sources.mjs",
    "collect:youtube": "node scripts/collect-youtube.mjs",
    "enrich:headings": "node scripts/enrich-article-headings.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "build:production": "node scripts/build-production.mjs",
    "sync:d1:upload": "node scripts/sync-d1-articles.mjs upload",
    "sync:d1:export": "node scripts/sync-d1-articles.mjs export",
    "sync:d1": "node scripts/sync-d1-articles.mjs sync",
    "seed:d1:approved": "node scripts/seed-approved-articles.mjs",
    "deploy:worker": "wrangler deploy --config worker/wrangler.jsonc",
    "deploy:pages": "node scripts/verify-article-previews.mjs --export && wrangler pages deploy out --project-name potover",
    "theme:generate": "node scripts/generate-theme.mjs",
    "theme:check": "node scripts/generate-theme.mjs --check",
    "dev:local": "NEXT_PUBLIC_POTOVER_API_URL=http://127.0.0.1:8787 next dev --hostname 127.0.0.1 --port 3001",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:api": "wrangler dev --local --config worker/wrangler.local.jsonc",
    "db:local": "wrangler d1 migrations apply potover-local --local --config worker/wrangler.local.jsonc",
    "verify": "npm run typecheck && npm run lint && npm test && npm run test:integration && npm run build:production",
    "test:integration": "node scripts/verify-local-worker.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "15.5.27",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "esbuild": "0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.27",
    "miniflare": "5.20261001.0-alpha",
    "typescript": "^5.6.3",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "postcss": "8.5.23"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
